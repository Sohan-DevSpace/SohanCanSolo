# ────────────────────────────────────────────────────────────
# Alpona — Environment Variables
# ────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or .env with real secrets.
# ────────────────────────────────────────────────────────────

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ───
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Razorpay ───
# Get from: Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── Qikink (Print-on-Demand) ───
# Get from: Qikink Dashboard
QIKINK_MOCK_MODE=true
QIKINK_API_URL=https://api.qikink.com
QIKINK_CLIENT_ID=your-qikink-client-id
QIKINK_CLIENT_SECRET=your-qikink-client-secret

# ─── Resend (Email) ───
# Get from: Resend Dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AI ───
# OpenRouter: Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Gemini: Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Cloudinary (Image Storage) ───
# Get from: Cloudinary Dashboard → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
